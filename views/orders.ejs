<%- include('partials/head') %>
<main><div class="wrap">
<h1>My purchases</h1>
<% if (!orders.length) { %><p class="muted">No purchases yet.</p><% } else { %>
<div class="table"><table><thead><tr><th>Date</th><th>Item</th><th>Amount</th><th>Status</th></tr></thead><tbody>
<% orders.forEach(o => { %><tr><td><%= fmtDate(o.created_at) %></td><td><%= o.item_title %></td><td><%= o.amount_cents ? money(o.amount_cents, o.currency) : 'Free' %></td><td><span class="tag <%= o.status === 'paid' ? 'on' : 'bad' %>"><%= o.status %></span></td></tr><% }) %>
</tbody></table></div><% } %>
</div></main>
<%- include('partials/foot') %>
