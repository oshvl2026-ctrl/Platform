<%- include('../partials/admin-top', { nav: '/admin/students' }) %>
<p class="small"><a href="/admin/students">All students</a></p>
<h1><%= student.name %></h1>
<p class="muted"><%= student.email %> &nbsp; Joined <%= fmtDate(student.created_at) %> <% if (student.role === 'admin') { %><span class="tag">Admin</span><% } %></p>
<h2 style="margin-top:28px">Courses</h2>
<% if (!enrolled.length) { %><p class="muted">Not enrolled in any course.</p><% } else { %>
<div class="table"><table><thead><tr><th>Course</th><th>Progress</th><th>How</th><th></th></tr></thead><tbody>
<% enrolled.forEach(c => { %><tr><td><%= c.title %></td><td style="min-width:160px"><div class="ruler thin"><span style="width:<%= c.progress.percent %>%"></span></div><span class="small muted"><%= c.progress.done %>/<%= c.progress.total %></span></td><td><%= c.source %></td>
<td><form method="post" class="inline" onsubmit="return confirm('Remove access to this course?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="course_id" value="<%= c.id %>"><button class="btn small danger" name="action" value="unenroll">Remove access</button></form></td></tr><% }) %>
</tbody></table></div><% } %>
<% if (others.length) { %>
<form method="post" class="row" style="margin-top:16px"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="sr-only" for="ec">Course</label><select id="ec" name="course_id" style="max-width:360px"><% others.forEach(c => { %><option value="<%= c.id %>"><%= c.title %></option><% }) %></select>
  <button class="btn quiet" name="action" value="enroll">Give free access</button></form>
<% } %>
<h2 style="margin-top:36px">Orders</h2>
<% if (!orders.length) { %><p class="muted">No orders.</p><% } else { %>
<div class="table"><table><tbody><% orders.forEach(o => { %><tr><td><%= fmtDate(o.created_at) %></td><td><%= o.item_title %></td><td><%= o.amount_cents ? money(o.amount_cents, o.currency) : 'Free' %></td><td><%= o.provider %></td><td><span class="tag <%= o.status === 'paid' ? 'on' : o.status === 'failed' ? 'bad' : 'warn' %>"><%= o.status %></span></td></tr><% }) %></tbody></table></div><% } %>
<div class="grid2" style="margin-top:36px;max-width:820px">
  <form method="post" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Set a new password</h3>
    <div class="field"><label for="np">New password</label><input id="np" name="password" type="text" minlength="8" required></div><button class="btn small" name="action" value="password">Set password</button></form>
  <% if (student.id !== user.id) { %>
  <form method="post" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Admin access</h3>
    <p class="muted small"><%= student.role === 'admin' ? 'This person can manage courses, students and sales.' : 'Admins can manage courses, students and sales.' %></p>
    <button class="btn small quiet" name="action" value="role" onclick="return confirm('Change admin access for this person?')"><%= student.role === 'admin' ? 'Remove admin access' : 'Make admin' %></button></form>
  <% } %>
</div>
<%- include('../partials/admin-bottom') %>
