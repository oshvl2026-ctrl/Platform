<%- include('../partials/head') %>
<main><div class="wrap" style="max-width:440px">
<h1>Create your account</h1>
<%- include('../partials/flash') %>
<form method="post" action="/signup" class="panel">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
  <div class="field"><label for="name">Full name <span class="hint">Shown on your certificates</span></label><input id="name" name="name" type="text" required value="<%= values.name || '' %>" autocomplete="name"></div>
  <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required value="<%= values.email || '' %>" autocomplete="email"></div>
  <div class="field"><label for="password">Password <span class="hint">At least 8 characters</span></label><input id="password" name="password" type="password" required minlength="8" autocomplete="new-password"></div>
  <button class="btn block">Create account</button>
</form>
<p class="muted small" style="margin-top:16px">Already have an account? <a href="/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>">Log in</a></p>
</div></main>
<%- include('../partials/foot') %>
